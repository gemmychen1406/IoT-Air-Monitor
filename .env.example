# Optional: existing full-stack development with YOUR OWN LOCAL PostgreSQL.
# The diagnostics:local preview ignores this file and needs no .env.
DATABASE_URL=postgresql://postgres:replace_with_local_password@127.0.0.1:5432/airguard_local
WEB_ORIGIN=http://127.0.0.1:5173
HOST=127.0.0.1
PORT=4000
TELEGRAM_ENABLED=false
# For a deployment dedicated to one household, add the bot to its private group.
# TELEGRAM_BOT_TOKEN=<token from BotFather>
# TELEGRAM_CHAT_ID=<numeric chat id of that group>
# TELEGRAM_GROUP_INVITE_URL=https://t.me/+example_only
TELEGRAM_INCLUDE_SIMULATORS=false
WEB_PUSH_ENABLED=false
# Generate once with npm run webpush:keys and keep both keys across deployments.
# WEB_PUSH_VAPID_PUBLIC_KEY=<public key>
# WEB_PUSH_VAPID_PRIVATE_KEY=<private key>
# WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.org
# For npm run admin:create only; remove ADMIN_PASSWORD after creating the user.
ADMIN_EMAIL=ha@airguard.local
ADMIN_PASSWORD=replace_with_at_least_12_characters
