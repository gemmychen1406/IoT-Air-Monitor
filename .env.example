# Optional: existing full-stack development with YOUR OWN LOCAL PostgreSQL.
# The diagnostics:local preview ignores this file and needs no .env.
DATABASE_URL=postgresql://postgres:replace_with_local_password@127.0.0.1:5432/airguard_local
WEB_ORIGIN=http://127.0.0.1:5173
HOST=127.0.0.1
PORT=4000
TELEGRAM_ENABLED=false
WEB_PUSH_ENABLED=false
# For npm run admin:create only; remove ADMIN_PASSWORD after creating the user.
ADMIN_EMAIL=ha@airguard.local
ADMIN_PASSWORD=replace_with_at_least_12_characters
