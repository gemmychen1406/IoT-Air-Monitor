{
  "name": "iot-gas-monitor",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web \"npm run dev -w @iot/api\" \"npm run dev -w @iot/web\"",
    "test": "vitest run",
    "test:integration": "tsx tests/run-integration.ts",
    "test:e2e": "tsx tests/run-integration.ts --browser",
    "test:load": "tsx tests/run-integration.ts --load",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run typecheck && npm run build -w @iot/web",
    "db:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "db:migrate": "node --env-file=.env node_modules/prisma/build/index.js migrate deploy",
    "admin:create": "tsx --env-file=.env apps/api/src/scripts/create-admin.ts",
    "simulate": "tsx --env-file=.env tools/device-simulator/src/main.ts",
    "db:backup": "tsx --env-file=.env tools/operations/main.ts backup",
    "db:restore": "tsx --env-file=.env tools/operations/main.ts restore",
    "db:maintenance": "tsx --env-file=.env tools/operations/main.ts maintenance",
    "webpush:keys": "tsx tools/operations/webpush-keys.ts",
    "cloud:api:build": "npm run db:generate",
    "cloud:api:migrate": "prisma migrate deploy",
    "cloud:api:start": "tsx apps/api/src/server.ts",
    "cloud:admin:create": "tsx apps/api/src/scripts/create-admin.ts",
    "cloud:simulator": "tsx tools/device-simulator/src/main.ts",
    "cloud:config:check": "node --test tests/cloud-config.test.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tanstack/react-query": "^5.90.0",
    "argon2": "^0.44.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "pino": "^10.0.0",
    "prisma": "^7.10.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.0",
    "recharts": "^3.3.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.20.0",
    "web-push": "^3.6.7",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.0",
    "supertest": "^7.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  }
}
